--========================================================
-- 📱 MOBILE TOUCH SWIPE CAMERA (รูดหน้าจอเพื่อหันกล้อง)
--========================================================

local cameraTouchInput = nil
local lastTouchPosition = nil

local function isTouchOverInteractiveUI(touchPos)
	local objects = gui:GetGuiObjectsAtPosition(touchPos.X, touchPos.Y)
	for _, obj in ipairs(objects) do
		if obj:IsDescendantOf(menu) or obj:IsDescendantOf(controls) or obj == toggle then
			return true
		end
	end
	return false
end

UIS.InputBegan:Connect(function(input)
	if not droneActive then return end

	-- จับการแตะบนมือถือเพื่อหันหน้าจอ
	if input.UserInputType == Enum.UserInputType.Touch then
		local pos = Vector2.new(input.Position.X, input.Position.Y)
		if not isTouchOverInteractiveUI(pos) and not cameraTouchInput then
			cameraTouchInput = input
			lastTouchPosition = pos
		end
	end
end)

UIS.InputChanged:Connect(function(input)
	if not droneActive then return end

	-- 1. หมุนกล้องบนมือถือ (Touch Drag)
	if input == cameraTouchInput and input.UserInputType == Enum.UserInputType.Touch then
		local curPos = Vector2.new(input.Position.X, input.Position.Y)
		local delta = curPos - lastTouchPosition
		lastTouchPosition = curPos

		yaw = yaw - (delta.X * TOUCH_SENSITIVITY)
		pitch = math.clamp(
			pitch - (delta.Y * TOUCH_SENSITIVITY),
			math.rad(-85),
			math.rad(85)
		)

	-- 2. หมุนกล้องบน PC (Mouse Movement)
	elseif input.UserInputType == Enum.UserInputType.MouseMovement and not isMobile then
		local delta = input.Delta
		yaw = yaw - (delta.X * MOUSE_SENSITIVITY)
		pitch = math.clamp(
			pitch - (delta.Y * MOUSE_SENSITIVITY),
			math.rad(-85),
			math.rad(85)
		)

	-- 3. ลูกกลิ้งเมาส์บน PC
	elseif input.UserInputType == Enum.UserInputType.MouseWheel then
		if input.Position.Z > 0 then
			SPEED = math.min(MAX_SPEED, SPEED + 50)
		else
			SPEED = math.max(MIN_SPEED, SPEED - 50)
		end
		updateSpeed()
	end
end)

UIS.InputEnded:Connect(function(input)
	if input == cameraTouchInput then
		cameraTouchInput = nil
		lastTouchPosition = nil
	end
end)

--========================================================
-- KEYBOARD HOTKEYS (PC)
--========================================================

UIS.InputBegan:Connect(function(input, gp)
	if gp then return end

	if input.KeyCode == Enum.KeyCode.F then
		if droneActive then stopDrone() else startDrone() end
	elseif input.KeyCode == Enum.KeyCode.R then
		triggerSelectBomb()
	elseif input.KeyCode == Enum.KeyCode.V then
		THIRD_PERSON = not THIRD_PERSON
		cameraButton.Text = THIRD_PERSON and "🎥 มุมมอง: 3D [V]" or "🎥 มุมมอง: FPV [V]"
	elseif input.KeyCode == Enum.KeyCode.W then forward = true
	elseif input.KeyCode == Enum.KeyCode.S then backward = true
	elseif input.KeyCode == Enum.KeyCode.A then left = true
	elseif input.KeyCode == Enum.KeyCode.D then right = true
	elseif input.KeyCode == Enum.KeyCode.Space then up = true
	elseif input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.LeftShift then down = true
	elseif input.KeyCode == Enum.KeyCode.Q then
		SPEED = math.max(MIN_SPEED, SPEED - 50)
		updateSpeed()
	elseif input.KeyCode == Enum.KeyCode.E then
		SPEED = math.min(MAX_SPEED, SPEED + 50)
		updateSpeed()
	elseif input.KeyCode == Enum.KeyCode.M then
		menuVisible = not menuVisible
		menu.Visible = menuVisible
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.W then forward = false
	elseif input.KeyCode == Enum.KeyCode.S then backward = false
	elseif input.KeyCode == Enum.KeyCode.A then left = false
	elseif input.KeyCode == Enum.KeyCode.D then right = false
	elseif input.KeyCode == Enum.KeyCode.Space then up = false
	elseif input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.LeftShift then down = false
	end
end)

--========================================================
-- MAIN FLIGHT LOOP
--========================================================

RunService.RenderStepped:Connect(function()
	if not droneActive or not bombFlying or not selectedBomb then
		hud.Visible = false
		controls.Visible = false
		return
	end

	if not selectedBomb.Parent then
		stopDrone()
		return
	end

	-- รักษา Mouse Lock ไว้เฉพาะผู้ใช้ PC
	if not isMobile and UIS.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
		UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
	end

	updateDroneUI()

	local look = getLookVector()
	local cameraCF = CFrame.lookAt(Vector3.zero, look)
	local cameraRight = cameraCF.RightVector
	local cameraUp = Vector3.new(0, 1, 0)

	local direction = Vector3.zero

	if forward then direction += look end
	if backward then direction -= look end
	if left then direction -= cameraRight end
	if right then direction += cameraRight end
	if up then direction += cameraUp end
	if down then direction -= cameraUp end

	if direction.Magnitude > 0 then
		direction = direction.Unit
	end

	if velocity then
		velocity.VectorVelocity = direction * SPEED
	end

	if orientation and direction.Magnitude > 0 then
		orientation.CFrame = CFrame.lookAt(Vector3.zero, direction)
	end

	Camera.CameraType = Enum.CameraType.Scriptable

	if THIRD_PERSON then
		local cameraPosition = selectedBomb.Position - (look * CAMERA_DISTANCE) + Vector3.new(0,6,0)
		Camera.CFrame = CFrame.lookAt(cameraPosition, cameraPosition + look)
	else
		Camera.CFrame = CFrame.lookAt(selectedBomb.Position, selectedBomb.Position + look)
	end

	local now = os.clock()
	local dt = math.max(now - lastUpdate, 0.001)
	local position = selectedBomb.Position
	local altitude = position.Y
	maxAltitude = math.max(maxAltitude, altitude)

	local currentSpeed = 0
	if lastPosition then
		currentSpeed = (position - lastPosition).Magnitude / dt
	end

	lastPosition = position
	lastUpdate = now

	local airTime = now - flightStart
	local heading = math.deg(math.atan2(-look.X, -look.Z))
	if heading < 0 then heading += 360 end

	local pitchDegrees = math.deg(pitch)
	local climb = look.Y * SPEED
	local throttle = math.clamp(direction.Magnitude, 0, 1) * 100

	pitchText.Text = string.format("PITCH: %+03d° | CLIMB: %03d S/S", math.floor(pitchDegrees), math.floor(climb))
	altText.Text = string.format("ALT: %04d studs | AIR: %.1fs", math.floor(altitude), airTime)
	maxText.Text = string.format("MAX: %04d studs | SPS: %03d S/S", math.floor(maxAltitude), math.floor(currentSpeed))
	thrText.Text = string.format("THR: %03d%% | DIR: %03d°", math.floor(throttle), math.floor(heading))

	local pitchPercent = math.clamp((pitchDegrees + 85) / 170, 0, 1)
	pitchBarFill.Size = UDim2.new(pitchPercent, 0, 1, 0)

	local speedPercent = math.clamp(SPEED / MAX_SPEED, 0, 1)
	speedFill.Size = UDim2.new(1, 0, speedPercent, 0)
end)

