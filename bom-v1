--========================================================
-- PHYSICS & TARGETING
--========================================================

local function getBombTarget()
	local origin = Camera.CFrame.Position
	local direction = Camera.CFrame.LookVector * 1500

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { LP.Character }

	local result = workspace:Raycast(origin, direction, params)
	if not result then return nil end

	local obj = result.Instance
	for _ = 1, 8 do
		if not obj then break end
		local name = string.lower(obj.Name)
		if string.find(name,"bomb") or string.find(name,"bom") then
			if obj:IsA("BasePart") then return obj end
			local p = obj:FindFirstChildWhichIsA("BasePart", true)
			if p then return p end
		end
		obj = obj.Parent
	end
	return nil
end

local attachment, velocity, orientation

local function clearPhysics()
	if velocity then velocity:Destroy(); velocity = nil end
	if orientation then orientation:Destroy(); orientation = nil end
	if attachment then attachment:Destroy(); attachment = nil end
end

local function setupPhysics(part)
	clearPhysics()

	attachment = Instance.new("Attachment")
	attachment.Parent = part

	velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = attachment
	velocity.MaxForce = math.huge
	velocity.VectorVelocity = Vector3.zero
	velocity.Parent = part

	orientation = Instance.new("AlignOrientation")
	orientation.Attachment0 = attachment
	orientation.MaxTorque = math.huge
	orientation.Responsiveness = 200
	orientation.Parent = part
end

local function readCameraAngles()
	local look = Camera.CFrame.LookVector
	yaw = math.atan2(-look.X, -look.Z)
	pitch = math.asin(math.clamp(look.Y, -1, 1))
end

local function getLookVector()
	return CFrame.fromOrientation(pitch, yaw, 0).LookVector
end

local function updateDroneUI()
	local active = droneActive and bombFlying and selectedBomb ~= nil and selectedBomb.Parent ~= nil
	hud.Visible = active
	controls.Visible = active and isMobile

	if active then
		if not droneSound.IsPlaying then droneSound:Play() end
	else
		if droneSound.IsPlaying then droneSound:Stop() end
	end
end

--========================================================
-- FLIGHT STOP / START
--========================================================

local function stopDrone()
	droneActive = false
	bombFlying = false

	forward = false
	backward = false
	left = false
	right = false
	up = false
	down = false

	clearPhysics()
	selectedBomb = nil
	hud.Visible = false
	controls.Visible = false

	if not isMobile then
		UIS.MouseBehavior = Enum.MouseBehavior.Default
	end

	if droneSound.IsPlaying then droneSound:Stop() end
	glitch.Visible = false

	Camera.CameraType = Enum.CameraType.Custom
	droneButton.Text = isMobile and "🚁 โดรน: ปิด" or "🚁 โดรน: ปิด [F]"
	bombButton.Text = isMobile and "💣 เลือกระเบิด" or "💣 เลือกระเบิด [R]"

	lastPosition = nil
	flightStart = 0
	maxAltitude = 0
end

local function startDrone()
	if not selectedBomb then
		selectedBomb = getBombTarget()
		if not selectedBomb then
			droneButton.Text = "🚁 ยังไม่ได้เลือก!"
			task.delay(1, function()
				if not droneActive then
					droneButton.Text = isMobile and "🚁 โดรน: ปิด" or "🚁 โดรน: ปิด [F]"
				end
			end)
			return
		end
	end

	readCameraAngles()
	setupPhysics(selectedBomb)

	droneActive = true
	bombFlying = true

	flightStart = os.clock()
	lastPosition = selectedBomb.Position
	maxAltitude = selectedBomb.Position.Y
	lastUpdate = os.clock()

	Camera.CameraType = Enum.CameraType.Scriptable

	-- ล็อคเมาส์เฉพาะบน PC เท่านั้น (ไม่ล็อคบนมือถือเพื่อให้รูดจอได้ปกติ)
	if not isMobile then
		UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
	end

	droneButton.Text = isMobile and "🚁 โดรน: เปิด" or "🚁 โดรน: เปิด [F]"
	updateDroneUI()
end

local function triggerSelectBomb()
	if droneActive then return end
	local targetObj = getBombTarget()
	if targetObj then
		selectedBomb = targetObj
		bombButton.Text = "💣 ล็อคเป้าแล้ว!"
	else
		selectedBomb = nil
		bombButton.Text = "💣 หาไม่เจอ"
	end
	task.delay(1, function()
		if not droneActive then
			bombButton.Text = isMobile and "💣 เลือกระเบิด" or "💣 เลือกระเบิด [R]"
		end
	end)
end

