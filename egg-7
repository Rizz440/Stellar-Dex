local function getCharacter()
    return localPlayer.Character or localPlayer.CharacterAdded:Wait()
end

local function getRootPart()
    local char = getCharacter()
    return char:WaitForChild("HumanoidRootPart", 5)
end

local function getHumanoid()
    local char = getCharacter()
    return char:WaitForChild("Humanoid", 5)
end

local function homePoint()
    if customHomePosition then
        return customHomePosition
    end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name == "EggDropZone" or obj.Name == "BaseDrop" or obj.Name == "DeliveryPoint" then
            if obj:IsA("BasePart") then
                return obj.Position + Vector3.new(0, 3, 0)
            end
        end
    end
    local spawnLocation = Workspace:FindFirstChildOfClass("SpawnLocation")
    if spawnLocation then
        return spawnLocation.Position + Vector3.new(0, 3, 0)
    end
    return Vector3.new(0, 5, 0)
end

local function lineInfo(p1, p2)
    local dir = p2 - p1
    local dist = dir.Magnitude
    local unit = dist > 0 and (dir / dist) or Vector3.new(0, 1, 0)
    return dir, dist, unit
end

local function instantFirePrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return end
    local oldHold = prompt.HoldDuration
    local oldReq = prompt.RequiresLineOfSight
    prompt.HoldDuration = 0
    prompt.RequiresLineOfSight = false
    
    pcall(function()
        if fireproximityprompt then
            fireproximityprompt(prompt)
        else
            prompt:InputHoldBegin()
            task.wait()
            prompt:InputHoldEnd()
        end
    end)
    
    prompt.HoldDuration = oldHold
    prompt.RequiresLineOfSight = oldReq
end

local function antiPullbackHop()
    local hum = getHumanoid()
    local root = getRootPart()
    if hum and root then
        hum.Jump = true
        root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 45, root.AssemblyLinearVelocity.Z)
    end
end

local function shieldSwap()
    pcall(function()
        local char = getCharacter()
        local tool = localPlayer.Backpack:FindFirstChildOfClass("Tool")
        if tool then
            local current = char:FindFirstChildOfClass("Tool")
            if current then
                current.Parent = localPlayer.Backpack
            end
            tool.Parent = char
            task.wait(0.05)
            tool.Parent = localPlayer.Backpack
        end
    end)
end

local function runToEgg(targetPos)
    local root = getRootPart()
    local hum = getHumanoid()
    if not root or not hum then return end
    
    local _, dist, _ = lineInfo(root.Position, targetPos)
    local t0 = tick()
    
    while dist > 4 and (tick() - t0 < 12) do
        hum:MoveTo(targetPos)
        local _, newDist, _ = lineInfo(root.Position, targetPos)
        if math.abs(newDist - dist) < 0.05 then
            antiPullbackHop()
            shieldSwap()
        end
        dist = newDist
        task.wait(0.15)
    end
end

local function flyToEgg(targetPos)
    local root = getRootPart()
    if not root then return end
    
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    bv.Velocity = Vector3.zero
    bv.Parent = root
    
    local bg = Instance.new("BodyGyro")
    bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    bg.CFrame = root.CFrame
    bg.Parent = root
    
    local speed = 55
    local _, dist, unit = lineInfo(root.Position, targetPos)
    local t0 = tick()
    
    while dist > 4 and (tick() - t0 < 10) do
        _, dist, unit = lineInfo(root.Position, targetPos)
        bv.Velocity = unit * speed
        bg.CFrame = CFrame.lookAt(root.Position, targetPos)
        RunService.Heartbeat:Wait()
    end
    
    bv:Destroy()
    bg:Destroy()
end

local function instantTP(targetPos)
    local root = getRootPart()
    if root then
        root.CFrame = CFrame.new(targetPos)
        task.wait(0.1)
    end
end

local function travelTo(pos)
    if travelMode == "Warp" then
        instantTP(pos)
    elseif travelMode == "Fly" then
        flyToEgg(pos)
    else
        runToEgg(pos)
    end
end

local function runHome()
    local targetPos = homePoint()
    travelTo(targetPos)
end

local function describe(model)
    local name = model.Name
    local price = 0
    local rarity = "Common"
    local rarityScore = 1
    
    for _, child in ipairs(model:GetChildren()) do
        if child:IsA("NumberValue") or child:IsA("IntValue") then
            if child.Name:lower():find("price") or child.Name:lower():find("cost") or child.Name:lower():find("val") then
                price = child.Value
            end
        elseif child:IsA("StringValue") then
            if child.Name:lower():find("rarity") or child.Name:lower():find("tier") then
                rarity = child.Value
            end
        end
    end
    
    for rName, score in pairs(rarityWeights) do
        if name:lower():find(rName:lower()) or rarity:lower():find(rName:lower()) then
            rarity = rName
            rarityScore = score
            break
        end
    end
    
    if price == 0 then
        price = rarityScore * 100
    end
    
    return {
        instance = model,
        name = name,
        price = price,
        rarity = rarity,
        rarityScore = rarityScore,
        pivot = model:GetPivot().Position
    }
end

local function snapshot()
    local eggs = {}
    for _, prompt in ipairs(Workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") and prompt.Enabled then
            local model = prompt.Parent:FindFirstAncestorOfClass("Model") or prompt.Parent
            if model and not eggs[model] then
                eggs[model] = true
            end
        end
    end
    
    local parsed = {}
    for eggModel, _ in pairs(eggs) do
        table.insert(parsed, describe(eggModel))
    end
    
    table.sort(parsed, function(a, b)
        if a.rarityScore == b.rarityScore then
            return a.price > b.price
        end
        return a.rarityScore > b.rarityScore
    end)
    
    cachedEggs = parsed
    return parsed
end

