local function grab(eggData)
    local model = eggData.instance
    if not model or not model.Parent then return false end
    
    travelTo(eggData.pivot)
    
    local prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        instantFirePrompt(prompt)
        task.wait(0.2)
        return true
    end
    return false
end

local function stealAndDeliver(eggData)
    local ok = grab(eggData)
    if ok then
        runHome()
        return true
    end
    return false
end

