task.spawn(function()
	while true do
		task.wait(0.2)
		local r = root()
		if not r then
			clearAllNearEggUIs()
			continue
		end

		local myPos = r.Position
		local active = {}
		local nearestDist = math.huge
		local nearestUid = nil

		local records = snapshot()
		for _, record in ipairs(records) do
			local uid = record.Uid
			local eggNode = workspace:FindFirstChild(uid)
			if not eggNode then
				local slots = workspace:FindFirstChild("AreaEggSlotsClient")
				eggNode = slots and slots:FindFirstChild(uid)
			end

			if eggNode and eggNode.Parent then
				local pos = nil
				pcall(function()
					pos = eggNode:GetPivot().Position
				end)

				if pos then
					local dist = (pos - myPos).Magnitude
					if dist <= CFG.NearEggRange then
						active[uid] = true
						if dist < nearestDist then
							nearestDist = dist
							nearestUid = uid
						end

						local part = nil
						if eggNode:IsA("BasePart") then
							part = eggNode
						elseif eggNode:IsA("Model") then
							part = eggNode.PrimaryPart or eggNode:FindFirstChildWhichIsA("BasePart", true)
						end

						if part then
							local info = describe(record)
							makeNearEggButton(uid, part, info)
							if nearEggUIs[uid] and nearEggUIs[uid].billboard then
								nearEggUIs[uid].billboard.Enabled = not state.Busy
							end
						end
					end
				end
			end
		end

		closestUidNearMe = nearestUid

		for uid in pairs(nearEggUIs) do
			if not active[uid] then
				clearNearEggUI(uid)
			end
		end
	end
end)

