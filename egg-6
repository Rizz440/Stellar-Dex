local function snapshot()
	local list = {}
	local seen = {}

	local ok, result = pcall(function()
		return remote("RF/EggWorld/AskFieldEggSnapshot"):InvokeServer()
	end)

	local records = ok and type(result) == "table" and result.Records or nil
	if type(records) ~= "table" then
		return list
	end

	for _, record in pairs(records) do
		if type(record) == "table"
			and type(record.Uid) == "string"
			and not seen[record.Uid]
			and (record.State == "Slot" or record.State == "Dropped")
			and typeof(record.BottomCFrame) == "CFrame"
		then
			local exists = workspace:FindFirstChild(record.Uid)
			if not exists then
				local slots = workspace:FindFirstChild("AreaEggSlotsClient")
				exists = slots and slots:FindFirstChild(record.Uid)
			end

			if exists then
				seen[record.Uid] = true
				list[#list + 1] = record
			end
		end
	end

	return list
end

local function eggPosition(uid)
