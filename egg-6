				if not grabbed then
					place(egg + Vector3.new(0, 3, 0))
					grabbed = grab(uid, 2)
				end

				if not grabbed then
					status("หยิบไข่ไม่สำเร็จ")
					return
				end

				local returnPos = root() and root().Position or grabPos

				status("กำลังวาร์ปส่งฐาน...")
				local home = homePoint()
				local lineX = lineInfo()
				local r = root()
				local laneZ = r and math.clamp(r.Position.Z, -420, -305) or -360

				if not customHomePosition then
					place(Vector3.new(lineX + 10, home.Y + 14, laneZ))
					task.wait(0.08)
				end

				place(home + Vector3.new(0, 4, 0))
				task.wait(0.18)

				if state.Carrying then
					dropEgg()
					local waited = 0
					while state.Carrying and waited < 1.3 and not state.Cancel do
						waited += RunService.Heartbeat:Wait()
					end
				end

				status("กำลังวาร์ปกลับจุดเดิม...")
				place(returnPos)
				task.wait(0.1)

				status(state.Delivered > 0 and "ส่งไข่สำเร็จ!" or "การส่งล้มเหลว")
				return
			end

			fpsOn()
			local reached = false
			if goMode == "Fly" then
				reached = flyToEgg(uid, egg)
			else
				reached = runToEgg(uid, egg)
			end

			if not reached and not state.Carrying then
				status("กำลังลองไล่ตามไข่ใหม่...")
				reached = chaseAndSteal(uid, 20)
			end

			if not reached and not state.Carrying then
				fpsOff()
				status("เข้าไม่ถึงตัวไข่")
				return
			end

			status("กำลังหยิบไข่...")
			if not state.Carrying then
				if not grab(uid, 4) then
					fpsOff()
					status("หยิบไข่ไม่สำเร็จ")
					return
				end
			end

			local delivered = instantTP(uid)
			status(delivered and "ส่งไข่สำเร็จ!" or "การส่งล้มเหลว")
		end)

		fpsOff()
		dropClone()
		if state.ReleaseCamera then
			pcall(state.ReleaseCamera)
			state.ReleaseCamera = nil
		end
		local r = root()
		if r and state.Cancel then
			pcall(function()
				r.AssemblyLinearVelocity = Vector3.zero
				r.AssemblyAngularVelocity = Vector3.zero
			end)
		end
		if not ok then
			status("เกิดข้อผิดพลาด: " .. tostring(err))
		end
		state.Busy = false
	end)
end

