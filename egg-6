local lastSnapshotHash = ""
local function getSnapshotHash()
	local parts = {}
	for _, record in ipairs(snapshot()) do
		parts[#parts + 1] = record.Uid
	end
	table.sort(parts)
	return table.concat(parts, "|")
end

local function rebuild(force)
	local hash = getSnapshotHash()
	if not force and hash == lastSnapshotHash then
		return
	end
	lastSnapshotHash = hash

	local oldScroll = list.CanvasPosition
	for _, row in pairs(rows) do
		row.Frame:Destroy()
	end
	table.clear(rows)

	local infos = {}
	local seenUid = {}
	for _, record in ipairs(snapshot()) do
		if not seenUid[record.Uid] then
			seenUid[record.Uid] = true
			infos[#infos + 1] = describe(record)
		end
	end

	table.sort(infos, function(a, b)
		return a.Value > b.Value
	end)

	local still = false
	for index, info in ipairs(infos) do
		still = still or info.Uid == selectedUid

		local frame = make("TextButton", {
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundColor3 = Color3.fromRGB(26, 26, 32),
