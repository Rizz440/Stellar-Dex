--========================================================
-- PHYSICS & TARGETING
--========================================================

local function getBombTarget()
	local origin = Camera.CFrame.Position
	local direction = Camera.CFrame.LookVector * 1500

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { LP.Character }

	local result = workspace:Raycast(origin, direction, params)
	if not result then return nil end

	local obj = result.Instance
	for _ = 1, 8 do
		if not obj then break end
		local name = string.lower(obj.Name)
		if string.find(name,"bomb") or string.find(name,"bom") then
			if obj:IsA("BasePart") then return obj end
			local p = obj:FindFirstChildWhichIsA("BasePart", true)
			if p then return p end
		end
		obj = obj.Parent
	end
	return nil
end

local attachment, velocity, orientation

local function clearPhysics()
	if velocity then velocity:Destroy(); velocity = nil end
	if orientation then orientation:Destroy(); orientation = nil end
	if attachment then attachment:Destroy(); attachment = nil end
end

local function setupPhysics(part)
	clearPhysics()

	attachment = Instance.new("Attachment")
	attachment.Parent = part

	velocity = Instance.new("LinearVelocity")
	velocity.Attachment0 = attachment
	velocity.MaxForce = math.huge
	velocity.VectorVelocity = Vector3.zero
	velocity.Parent = part

	orientation = Instance.new("AlignOrientation")
	orientation.Attachment0 = attachment
	orientation.MaxTorque = math.huge
	orientation.Responsiveness = 200
	orientation.Parent = part
end

local function readCameraAngles()
	local look = Camera.CFrame.LookVector
	yaw = math.atan2(-look.X, -look.Z)
	pitch = math.asin(math.clamp(look.Y, -1, 1))
end

local function getLookVector()
	return CFrame.fromOrientation(pitch, yaw, 0).LookVector
end

local function updateDroneUI()
	local active = droneActive and bombFlying and selectedBomb ~= nil and selectedBomb.Parent ~= nil
	hud.Visible = active

	if active then
		if not droneSound.IsPlaying then droneSound:Play() end
	else
		if droneSound.IsPlaying then droneSound:Stop() end
	end
end

--========================================================
-- FLIGHT CYCLE (STOP / START)
--========================================================

local function stopDrone()
	droneActive = false
	bombFlying = false

	forward = false
	backward = false
	left = false
	right = false
	up = false
	down = false

	clearPhysics()
	selectedBomb = nil
	hud.Visible = false

	-- ปลดล็อคเมาส์กลับเป็นปกติบน PC
	UIS.MouseBehavior = Enum.MouseBehavior.Default

	if droneSound.IsPlaying then droneSound:Stop() end
	glitch.Visible = false

	Camera.CameraType = Enum.CameraType.Custom
	droneButton.Text = "🚁 โดรน: ปิด [F]"
	bombButton.Text = "💣 เลือกระเบิด [R]"

	lastPosition = nil
	flightStart = 0
	maxAltitude = 0
end

local function startDrone()
	if not selectedBomb then
		selectedBomb = getBombTarget()
		if not selectedBomb then
			droneButton.Text = "🚁 ยังไม่ได้เลือก!"
			task.delay(1, function()
				if not droneActive then droneButton.Text = "🚁 โดรน: ปิด [F]" end
			end)
			return
		end
	end

	readCameraAngles()
	setupPhysics(selectedBomb)

	droneActive = true
	bombFlying = true

	flightStart = os.clock()
	lastPosition = selectedBomb.Position
	maxAltitude = selectedBomb.Position.Y
	lastUpdate = os.clock()

	Camera.CameraType = Enum.CameraType.Scriptable

	-- ล็อคเมาส์เข้ากลางจอทันทีบน PC ขยับเมาส์บังคับเลี้ยวได้เลย
	UIS.MouseBehavior = Enum.MouseBehavior.LockCenter

	droneButton.Text = "🚁 โดรน: เปิด [F]"
	updateDroneUI()
end

local function triggerSelectBomb()
	if droneActive then return end
	local targetObj = getBombTarget()
	if targetObj then
		selectedBomb = targetObj
		bombButton.Text = "💣 ล็อคเป้าแล้ว!"
	else
		selectedBomb = nil
		bombButton.Text = "💣 หาไม่เจอ"
	end
	task.delay(1, function()
		if not droneActive then
			bombButton.Text = "💣 เลือกระเบิด [R]"
		end
	end)
end

bombButton.Activated:Connect(triggerSelectBomb)

droneButton.Activated:Connect(function()
	if droneActive then stopDrone() else startDrone() end
end)

cameraButton.Activated:Connect(function()
	THIRD_PERSON = not THIRD_PERSON
	cameraButton.Text = THIRD_PERSON and "🎥 มุมมอง: 3D [V]" or "🎥 มุมมอง: FPV [V]"
end)

local function updateSpeed()
	speedLabel.Text = "ความเร็ว: "..SPEED.." [Scroll]"
end

speedDown.Activated:Connect(function()
	SPEED = math.max(MIN_SPEED, SPEED - 50)
	updateSpeed()
end)

speedUp.Activated:Connect(function()
	SPEED = math.min(MAX_SPEED, SPEED + 50)
	updateSpeed()
end)

--========================================================
-- PC MOUSE CONTROLS (FPS / SIMULATOR FLIGHT)
--========================================================

UIS.InputChanged:Connect(function(input)
	if not droneActive then return end

	-- เลี้ยวโดรนตามเมาส์ขณะบิน
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Delta

		yaw = yaw - (delta.X * CAMERA_SENSITIVITY)
		pitch = math.clamp(
			pitch - (delta.Y * CAMERA_SENSITIVITY),
			math.rad(-85),
			math.rad(85)
		)
	-- ปรับความเร็วด้วยลูกกลิ้งเมาส์ (Scroll Wheel)
	elseif input.UserInputType == Enum.UserInputType.MouseWheel then
		if input.Position.Z > 0 then
			SPEED = math.min(MAX_SPEED, SPEED + 50)
		else
			SPEED = math.max(MIN_SPEED, SPEED - 50)
		end
		updateSpeed()
	end
end)

--========================================================
-- KEYBOARD HOTKEYS (PC DRIVING)
--========================================================

UIS.InputBegan:Connect(function(input, gp)
	if gp then return end

	-- Flight Toggle
	if input.KeyCode == Enum.KeyCode.F then
		if droneActive then stopDrone() else startDrone() end

	-- Bomb Quick-Lock
	elseif input.KeyCode == Enum.KeyCode.R then
		triggerSelectBomb()

	-- Camera Mode
	elseif input.KeyCode == Enum.KeyCode.V then
		THIRD_PERSON = not THIRD_PERSON
		cameraButton.Text = THIRD_PERSON and "🎥 มุมมอง: 3D [V]" or "🎥 มุมมอง: FPV [V]"

	-- Directionals
	elseif input.KeyCode == Enum.KeyCode.W then
		forward = true
	elseif input.KeyCode == Enum.KeyCode.S then
		backward = true
	elseif input.KeyCode == Enum.KeyCode.A then
		left = true
	elseif input.KeyCode == Enum.KeyCode.D then
		right = true
	elseif input.KeyCode == Enum.KeyCode.Space then
		up = true
	elseif input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.LeftShift then
		down = true

	-- Speed Adjust
	elseif input.KeyCode == Enum.KeyCode.Q then
		SPEED = math.max(MIN_SPEED, SPEED - 50)
		updateSpeed()
	elseif input.KeyCode == Enum.KeyCode.E then
		SPEED = math.min(MAX_SPEED, SPEED + 50)
		updateSpeed()

	-- Menu Toggle
	elseif input.KeyCode == Enum.KeyCode.M then
		menuVisible = not menuVisible
		menu.Visible = menuVisible
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.W then forward = false
	elseif input.KeyCode == Enum.KeyCode.S then backward = false
	elseif input.KeyCode == Enum.KeyCode.A then left = false
	elseif input.KeyCode == Enum.KeyCode.D then right = false
	elseif input.KeyCode == Enum.KeyCode.Space then up = false
	elseif input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.LeftShift then down = false
	end
end)

--========================================================
-- MAIN FLIGHT LOOP
--========================================================

RunService.RenderStepped:Connect(function()
	if not droneActive or not bombFlying or not selectedBomb then
		hud.Visible = false
		return
	end

	if not selectedBomb.Parent then
		stopDrone()
		return
	end

	-- บังคับล็อคเมาส์ตลอดเวลาขณะกำลังบิน
	if UIS.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
		UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
	end

	updateDroneUI()

	local look = getLookVector()
	local cameraCF = CFrame.lookAt(Vector3.zero, look)
	local cameraRight = cameraCF.RightVector
	local cameraUp = Vector3.new(0, 1, 0)

	local direction = Vector3.zero

	if forward then direction += look end
	if backward then direction -= look end
	if left then direction -= cameraRight end
	if right then direction += cameraRight end
	if up then direction += cameraUp end
	if down then direction -= cameraUp end

	if direction.Magnitude > 0 then
		direction = direction.Unit
	end

	if velocity then
		velocity.VectorVelocity = direction * SPEED
	end

	if orientation and direction.Magnitude > 0 then
		orientation.CFrame = CFrame.lookAt(Vector3.zero, direction)
	end

	Camera.CameraType = Enum.CameraType.Scriptable

	if THIRD_PERSON then
		local cameraPosition = selectedBomb.Position - (look * CAMERA_DISTANCE) + Vector3.new(0,6,0)
		Camera.CFrame = CFrame.lookAt(cameraPosition, cameraPosition + look)
	else
		Camera.CFrame = CFrame.lookAt(selectedBomb.Position, selectedBomb.Position + look)
	end

	local now = os.clock()
	local dt = math.max(now - lastUpdate, 0.001)
	local position = selectedBomb.Position
	local altitude = position.Y
	maxAltitude = math.max(maxAltitude, altitude)

	local currentSpeed = 0
	if lastPosition then
		currentSpeed = (position - lastPosition).Magnitude / dt
	end

	lastPosition = position
	lastUpdate = now

	local airTime = now - flightStart
	local heading = math.deg(math.atan2(-look.X, -look.Z))
	if heading < 0 then heading += 360 end

	local pitchDegrees = math.deg(pitch)
	local climb = look.Y * SPEED
	local throttle = math.clamp(direction.Magnitude, 0, 1) * 100

	pitchText.Text = string.format("PITCH: %+03d° | CLIMB: %03d S/S", math.floor(pitchDegrees), math.floor(climb))
	altText.Text = string.format("ALT: %04d studs | AIR: %.1fs", math.floor(altitude), airTime)
	maxText.Text = string.format("MAX: %04d studs | SPS: %03d S/S", math.floor(maxAltitude), math.floor(currentSpeed))
	thrText.Text = string.format("THR: %03d%% | DIR: %03d°", math.floor(throttle), math.floor(heading))

	local pitchPercent = math.clamp((pitchDegrees + 85) / 170, 0, 1)
	pitchBarFill.Size = UDim2.new(pitchPercent, 0, 1, 0)

	local speedPercent = math.clamp(SPEED / MAX_SPEED, 0, 1)
	speedFill.Size = UDim2.new(1, 0, speedPercent, 0)
end)

